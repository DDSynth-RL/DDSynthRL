# Copy this file to ".env" for local machine-specific settings.
# ".env" is excluded from version control by default.
# Hydra can reference variables in YAML configs with syntax such as ${oc.env:MY_VAR}.

MY_VAR="path/to/your/system/resource"

# Dexed bridge config (optional override)
DEXED_PARAM_SUMMARY="configs/data/dexed_params_summary.yaml"

# Surge bridge config (optional override)
SURGE_PARAM_SUMMARY="configs/data/surge_params_summary.yaml"
